WP_SITE_URL=https://logistictrade.com
WP_USERNAME=your-wp-username
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# MCP: servidor de Google Search Console (gscServer)
# Ruta local donde clonaste el repo mcp-gsc (https://github.com/AminForou/mcp-gsc)
MCP_GSC_DIR=/ruta/a/mcp-gsc
# Ruta al archivo de credenciales OAuth de Google Search Console
GSC_OAUTH_CLIENT_SECRETS_FILE=/ruta/a/client_secrets.json
